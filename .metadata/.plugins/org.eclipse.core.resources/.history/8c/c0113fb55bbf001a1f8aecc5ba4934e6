package com.datastructures;

import java.util.ArrayList;
import java.util.HashMap;
import java.util.List;
import java.util.Map;

public final class Customer {
 
	private final String name;
	private final int age;
	private final List<String> items;
	Customer(String name,int age, ArrayList<String> list)
	{
		this.name=name;
		this.age=age;
		this.items=list;
		list = new ArrayList<>();
	}
	
	public String getName() {
		return name;
	}


	public int getAge() {
		return age;
	}


	public List<String> getItems() {
		return items;
	}
	@Override
	public boolean equals(Object arg0) {
		// TODO Auto-generated method stub
		
		Customer cus = (Customer) arg0;
		
		return this.name.equals(cus.name) && this.age==cus.age;
	}
	
	@Override
	public int hashCode() {
		// TODO Auto-generated method stub
		return 1;
	}
	
	public static void main(String[] args) {
		List<String> items = new ArrayList<>();
		items.add("1");items.add("2");
		Customer c1= new Customer("John",20, (ArrayList<String>) items);
		Customer c2= new Customer("John",20, (ArrayList<String>) items);
//		items = new ArrayList<>();
		System.out.println(items.size());
		items.add("3");
		Map<Customer, String> customerSet=new HashMap<>();
		customerSet.put(c1,"verified");
		customerSet.put(c2,"verified");
		System.out.println("items " +items.size()+" "+c1.getItems().size());
//		customerSet.add(c2,"yg");
		
		System.out.println(customerSet.size());
		
		
	}
 
	// getters and setters
}