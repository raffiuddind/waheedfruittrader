<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="StockCameIntruck" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="37b04cae-fcdc-4562-93c1-1b9fb59e0f56">
	<property name="ireport.zoom" value="1.0"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="trk" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT inv.`INVOICE_ID`,ld.`LOAD_ID`,inv.`INV_DATE`,p.`PRODUCT_NAME`,
ct.`CATEGORY_TYPE`,ld.`QNTY`,ld.`UNIT_COST`,ld.`TOTAL`,ld.`CAT_ID`,ld.`SUPPLIER_ID`,s.`SUPPLIER_NAME`
,ld.`LOAD_ID`,inv.`TRUCK_NO` FROM load_details ld
INNER JOIN invoice inv ON inv.`INVOICE_ID`=ld.`INVOICE_ID`
INNER JOIN product_category ct ON ct.`CAT_ID`=ld.`CAT_ID`
INNER JOIN product p ON p.`P_ID`=ct.`P_ID`
INNER JOIN supplier s ON s.`SUPPLIER_ID`=ld.`SUPPLIER_ID`

WHERE inv.`TRUCK_NO`=$P{trk}]]>
	</queryString>
