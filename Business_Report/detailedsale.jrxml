<?xml version="1.0" encoding="UTF-8"?>
<jasperReport xmlns="http://jasperreports.sourceforge.net/jasperreports" xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:schemaLocation="http://jasperreports.sourceforge.net/jasperreports http://jasperreports.sourceforge.net/xsd/jasperreport.xsd" name="detailedsale" language="groovy" pageWidth="595" pageHeight="842" columnWidth="555" leftMargin="20" rightMargin="20" topMargin="20" bottomMargin="20" uuid="8585404a-4996-4765-9451-5c8b23cef08e">
	<property name="ireport.zoom" value="1.1"/>
	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="0"/>
	<parameter name="truck" class="java.lang.String"/>
	<parameter name="dt1" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="dt2" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<queryString>
		<![CDATA[SELECT c.`NAME`,p.`PRODUCT_NAME`,cat.`CATEGORY_TYPE`,cat.`CAT_ID`,(ttrx.`QNTY`)
,ttrx.`UNIT_COST`,(ttrx.`TOTAL`),inv.`TRUCK_NO`,inv.INV_DATE,ld.`QNTY`,tr.`T_DATE`
 FROM ttl_transaction ttrx
INNER JOIN `transaction` tr ON tr.`T_ID`=ttrx.`T_ID`
INNER JOIN customer c ON c.`CUSTOMER_ID`=tr.`CUSTOMER_ID`

INNER JOIN load_details ld ON ld.`LOAD_ID`=ttrx.`LOAD_ID`
INNER JOIN invoice inv ON inv.`INVOICE_ID`=ld.`INVOICE_ID`
INNER JOIN product_category cat ON cat.`CAT_ID`=ttrx.`CAT_ID`
INNER JOIN product p ON p.`P_ID`=cat.`P_ID`
INNER JOIN supplier s ON s.`SUPPLIER_ID`=ld.`SUPPLIER_ID`
WHERE inv.`TRUCK_NO`=$P{truck} AND inv.INV_DATE BETWEEN $P{dt1} AND $P{dt2}
GROUP BY ttrx.`TT_ID`,ttrx.`CAT_ID`,ttrx.UNIT_COST]]>
	</queryString>
