	<subDataset name="New Dataset 1" uuid="8eb5aa6c-b133-4c5e-b51a-6feacd20aef4">
		<queryString language="SQL">
			<![CDATA[SELECT en.idtbl_expenditure,exp.idexp_amount,en.`EXPENDITURE`,SUM(exp.`EXP_AMOUNT`),exp.exp_date FROM exp_amount exp
INNER JOIN tbl_expenditure en ON en.idtbl_expenditure=exp.idtbl_expenditure
WHERE exp.exp_date between '' and '2016/12/12' GROUP BY en.idtbl_expenditure
ORDER BY exp.exp_date,exp.idexp_amount]]>
		</queryString>
		<field name="idtbl_expenditure" class="java.lang.Integer">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="idexp_amount" class="java.lang.Integer">
