	<variable name="Total_coll" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{sNo}.parseInt((null==$F{cash})?"0":$F{cash}.replaceAll(",",""))]]></variableExpression>
	</variable>
	<variable name="variable1" class="java.lang.Long" calculation="Sum">
		<variableExpression><![CDATA[$F{sNo}.parseInt((null==$F{discount})?"0":$F{discount}.replaceAll(",",""))]]></variableExpression>
	</variable>
