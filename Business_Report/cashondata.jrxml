	<subDataset name="exp_data" whenResourceMissingType="Empty" uuid="24806781-d331-45df-a7fa-1a024d1da0ec">
		<parameter name="con" class="java.lang.Object" isForPrompting="false">
			<defaultValueExpression><![CDATA[$P{REPORT_CONNECTION}]]></defaultValueExpression>
		</parameter>
		<parameter name="dt" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<parameter name="dt2" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT
     SUM(exp.`EXP_AMOUNT`),
     en.`idtbl_expenditure`,
     exp.`idexp_amount`,
     en.`EXPENDITURE`,
     exp.`exp_date`
FROM
     `tbl_expenditure` en INNER JOIN `exp_amount` exp ON en.`idtbl_expenditure` = exp.`idtbl_expenditure`
WHERE
     exp.exp_date BETWEEN $P{dt} and $P{dt2}
GROUP BY
     en.idtbl_expenditure
ORDER BY
     exp.exp_date ASC,
     exp.idexp_amount ASC]]>
		</queryString>
		<field name="SUM(exp.`EXP_AMOUNT`)" class="java.lang.Double"/>
		<field name="idtbl_expenditure" class="java.lang.Integer">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="idexp_amount" class="java.lang.Integer">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="EXPENDITURE" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="exp_date" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<variable name="variable1" class="java.lang.Long" calculation="Sum">
			<variableExpression><![CDATA[$F{SUM(exp.`EXP_AMOUNT`)}]]></variableExpression>
		</variable>
		<group name="EXPENDITURE">
			<groupExpression><![CDATA[$F{EXPENDITURE}]]></groupExpression>
		</group>
	</subDataset>
	<parameter name="dt" class="java.lang.String">
		<parameterDescription><![CDATA[]]></parameterDescription>
	</parameter>
	<parameter name="l" class="java.lang.String"/>
	<parameter name="tot_c" class="java.lang.String"/>
	<parameter name="dt2" class="java.lang.String"/>
	<parameter name="tot_e" class="java.lang.String"/>
