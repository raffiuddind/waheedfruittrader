	<subDataset name="Table Dataset 1" uuid="70c53553-9ea1-41fb-999f-b0fa36b62c14">
		<parameter name="trk" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT c.`NAME`,p.`PRODUCT_NAME`,cat.`CATEGORY_TYPE`,cat.`CAT_ID`,SUM(ttrx.`QNTY`)
,ttrx.`UNIT_COST`,SUM(ttrx.`TOTAL`),inv.`TRUCK_NO`,inv.INV_DATE,ld.`QNTY`,tr.`T_DATE`
 FROM ttl_transaction ttrx
INNER JOIN `transaction` tr ON tr.`T_ID`=ttrx.`T_ID`
INNER JOIN customer c ON c.`CUSTOMER_ID`=tr.`CUSTOMER_ID`

INNER JOIN load_details ld ON ld.`LOAD_ID`=ttrx.`LOAD_ID`
INNER JOIN invoice inv ON inv.`INVOICE_ID`=ld.`INVOICE_ID`
INNER JOIN product_category cat ON cat.`CAT_ID`=ttrx.`CAT_ID`
INNER JOIN product p ON p.`P_ID`=cat.`P_ID`
INNER JOIN supplier s ON s.`SUPPLIER_ID`=ld.`SUPPLIER_ID`
WHERE inv.`TRUCK_NO`=$P{trk} AND ld.`ACTIVE`=true
GROUP BY ttrx.`CAT_ID`,ttrx.UNIT_COST]]>
		</queryString>
		<field name="NAME" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="PRODUCT_NAME" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="CATEGORY_TYPE" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="CAT_ID" class="java.lang.Integer">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="SUM(ttrx.`QNTY`)" class="java.math.BigDecimal"/>
		<field name="UNIT_COST" class="java.lang.Integer">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="SUM(ttrx.`TOTAL`)" class="java.math.BigDecimal"/>
		<field name="TRUCK_NO" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="INV_DATE" class="java.sql.Date">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="QNTY" class="java.lang.Integer">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="T_DATE" class="java.sql.Date">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<variable name="qntysum" class="java.lang.Integer" calculation="Sum">
			<variableExpression><![CDATA[$F{SUM(ttrx.`QNTY`)}]]></variableExpression>
		</variable>
	</subDataset>
