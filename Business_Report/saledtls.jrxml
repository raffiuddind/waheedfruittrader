	<subDataset name="New Dataset 1" uuid="a6e8adfc-6bae-4c61-8039-90882f19a0a5">
		<parameter name="truck" class="java.lang.String">
			<defaultValueExpression><![CDATA[]]></defaultValueExpression>
		</parameter>
		<queryString>
			<![CDATA[SELECT c.`NAME`,p.`PRODUCT_NAME`,cat.`CATEGORY_TYPE`,cat.`CAT_ID`,(ttrx.`QNTY`)
,ttrx.`UNIT_COST`,(ttrx.`TOTAL`),inv.`TRUCK_NO`,inv.INV_DATE,ld.`QNTY`,tr.`T_DATE`
 FROM ttl_transaction ttrx
INNER JOIN `transaction` tr ON tr.`T_ID`=ttrx.`T_ID`
INNER JOIN customer c ON c.`CUSTOMER_ID`=tr.`CUSTOMER_ID`

INNER JOIN load_details ld ON ld.`LOAD_ID`=ttrx.`LOAD_ID`
INNER JOIN invoice inv ON inv.`INVOICE_ID`=ld.`INVOICE_ID`
INNER JOIN product_category cat ON cat.`CAT_ID`=ttrx.`CAT_ID`
INNER JOIN product p ON p.`P_ID`=cat.`P_ID`
INNER JOIN supplier s ON s.`SUPPLIER_ID`=ld.`SUPPLIER_ID`
WHERE inv.`TRUCK_NO`=$P{truck} AND ld.`ACTIVE`=true
GROUP BY ttrx.`TT_ID`,ttrx.`CAT_ID`,ttrx.UNIT_COST]]>
		</queryString>
		<field name="NAME" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="PRODUCT_NAME" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
		<field name="CATEGORY_TYPE" class="java.lang.String">
			<fieldDescription><![CDATA[]]></fieldDescription>
		</field>
