	<property name="ireport.x" value="0"/>
	<property name="ireport.y" value="123"/>
	<parameter name="trk" class="java.lang.String">
		<defaultValueExpression><![CDATA[]]></defaultValueExpression>
	</parameter>
	<parameter name="exp" class="java.lang.Integer"/>
	<parameter name="hire" class="java.lang.Integer"/>
	<parameter name="cooli" class="java.lang.Integer"/>
	<parameter name="cash" class="java.lang.Integer"/>
	<parameter name="kata" class="java.lang.Integer"/>
	<parameter name="amc" class="java.lang.Integer"/>
	<parameter name="ftot" class="java.lang.Long"/>
	<parameter name="gr" class="java.lang.String"/>
	<parameter name="invdt" class="java.lang.String"/>
	<parameter name="sp" class="java.lang.String"/>
	<parameter name="qty" class="java.lang.String"/>
	<queryString>
		<![CDATA[SELECT c.`NAME`,p.`PRODUCT_NAME`,cat.`CATEGORY_TYPE`,cat.`CAT_ID`,SUM(ttrx.`QNTY`)
,ttrx.`UNIT_COST`,SUM(ttrx.`TOTAL`),inv.`TRUCK_NO`,inv.INV_DATE,ld.`QNTY`,
(SELECT tr.`T_DATE`
ORDER BY tr.`T_DATE` desc LIMIT 1) as edate
 FROM ttl_transaction ttrx
INNER JOIN `transaction` tr ON tr.`T_ID`=ttrx.`T_ID`
INNER JOIN customer c ON c.`CUSTOMER_ID`=tr.`CUSTOMER_ID`

INNER JOIN load_details ld ON ld.`LOAD_ID`=ttrx.`LOAD_ID`
INNER JOIN invoice inv ON inv.`INVOICE_ID`=ld.`INVOICE_ID`
INNER JOIN product_category cat ON cat.`CAT_ID`=ttrx.`CAT_ID`
INNER JOIN product p ON p.`P_ID`=cat.`P_ID`
INNER JOIN supplier s ON s.`SUPPLIER_ID`=ld.`SUPPLIER_ID`
WHERE ld.`LOAD_ID`=$P{trk}
GROUP BY ttrx.`CAT_ID`,ttrx.UNIT_COST]]>
	</queryString>
	<field name="item" class="java.lang.String">
		<fieldDescription><![CDATA[item]]></fieldDescription>
	</field>
	<field name="qnty" class="java.lang.String">
